{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Go API)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/api",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend (Flutter)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/frontend",
      // Load Flutter's web engine from this machine instead of Google's CDN,
      // which is slow on this connection and leaves Chrome blank.
      "args": ["--no-web-resources-cdn"]
    },
    {
      // Web: store buttons open the official web listing in a new tab.
      "name": "Frontend: Chrome",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/frontend",
      "deviceId": "chrome",
      "args": ["--no-web-resources-cdn", "--dart-define=API_BASE_URL=http://localhost:8080/api/v1"]
    },
    {
      // Desktop: tries steam:// / com.epicgames.launcher:// first, then the web page.
      // Needs Visual Studio's "Desktop development with C++" workload.
      "name": "Frontend: Windows desktop",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/frontend",
      "deviceId": "windows",
      "args": ["--dart-define=API_BASE_URL=http://localhost:8080/api/v1"]
    },
    {
      // Android emulator: opens Google Play (market://). 10.0.2.2 is your PC.
      // Needs the Android SDK and a running emulator or phone.
      "name": "Frontend: Android",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/frontend",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:8080/api/v1"]
    },
    {
      // Runs the Smart Download / Play Now tests with simulated Android,
      // iOS, Windows and browser devices. No API or device needed.
      "name": "Tests: Get the game",
      "type": "dart",
      "request": "launch",
      "program": "test/get_game_test.dart",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "API + app in Chrome",
      "configurations": ["Backend (Go API)", "Frontend: Chrome"],
      "stopAll": true
    }
  ]
}
