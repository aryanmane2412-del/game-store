# Copy this file to .env and adjust. Never commit .env.
# Every value is optional — the defaults shown are used when a line is missing.

# development | production
APP_ENV=development
PORT=8080
APP_VERSION=0.1.0

# Logging: LOG_LEVEL = debug | info | warn | error, LOG_FORMAT = text | json
LOG_LEVEL=info
LOG_FORMAT=text

# Comma-separated browser origins allowed to call the API.
# ":*" allows any port — the Flutter web dev server uses a random localhost port.
# In production list your real site(s), e.g. https://app.yourdomain.com  (no "*").
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Reverse proxy addresses (comma-separated IPs or CIDRs) whose X-Forwarded-For
# header is trusted for the client IP used by login rate limits. Set this when
# the API runs behind Caddy/nginx/a load balancer, e.g. 127.0.0.1 — otherwise
# every user shares the proxy's IP and its rate limit. Leave empty when clients
# connect directly.
TRUSTED_PROXIES=

# HTTP server limits
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=1048576

# Where uploaded game images are stored during development
UPLOAD_DIR=./uploads

# ---------- PostgreSQL ----------
# Leave these out to run the API on built-in sample data instead.
# The password stays in this git-ignored file only — never in code or the Flutter app.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=game_discovery
# disable for local development; require (or verify-full) in production
DB_SSLMODE=disable

# Or give one full connection string instead of the DB_* lines above:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# Connection pool
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Tests use their own databases named <DB_NAME>_test_<package> on the same server.
# Or point them elsewhere: TEST_DATABASE_URL=postgres://...

# ---------- Sign-in ----------
# Sessions are random tokens stored hashed in PostgreSQL — there is no signing
# secret to configure or leak. Logging out deletes the session immediately.
# A session ends after 30 days at most, or after 7 days without use.
AUTH_SESSION_TTL=720h
AUTH_IDLE_TIMEOUT=168h
# Password reset codes expire after 30 minutes.
AUTH_RESET_TTL=30m
# There is no email service yet: in development (APP_ENV=development) reset
# codes are printed in the API's log instead of being emailed.

# ---------- Production ----------
# The API refuses to start in production unless these are safe:
#   APP_ENV=production
#   DB_SSLMODE=require            (or verify-full) — TLS to the database
#   CORS_ALLOWED_ORIGINS=https://app.yourdomain.com   (https only, no "*", no ":*")
#   a database must be configured (no sample-data / in-memory fallback)
# Recommended:
#   LOG_FORMAT=json               for log collectors
#   DB_USER=<a dedicated app role, not the postgres superuser>  (see docs/DATABASE.md)
#   UPLOAD_DIR=/var/lib/game-discovery/uploads   a persistent, backed-up volume
# Secrets (DB_PASSWORD / DATABASE_URL) belong in your host's secret store or
# environment, never in git or in the Flutter app.
